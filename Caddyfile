# TLS is terminated upstream of this container in production — a separate Traefik
# instance on the Hostinger VPS (see CLAUDE.md), which issues a real Let's Encrypt
# certificate and forwards plain HTTP here. SITE_ADDRESS is always http://<domain> in
# production; Caddy never attempts its own certificate. The bare-domain form (no
# scheme) only matters for local dev, where SITE_ADDRESS defaults to http://localhost
# below anyway.

{$SITE_ADDRESS:http://localhost} {
	reverse_proxy app:8000

	encode gzip

	# img-src allows https: (not just 'self') because album art URLs come directly
	# from Spotify's API responses, hosted on Spotify's own CDN, not this app.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# HTML responses are dynamic (CSRF tokens on forms, live now-playing status) and
	# must never be cached — a stale cached form would submit an expired CSRF token.
	# Static assets rarely change and aren't cache-busted by filename, so a moderate
	# TTL balances freshness against repeat-visit load time.
	@static path /static/*
	header @static Cache-Control "public, max-age=3600"

	@dynamic not path /static/*
	header @dynamic Cache-Control "no-store"
}
